---
import SectionTitle from "../Section-Title/Section-Title.astro"
import GradientCircles from '../GradientCircles/GradientCircles.astro';
import StyledSectionTitle from '../StyledSectionTitle/StyledSectionTitle.astro';
import { eventos } from '../../data/events';
---

<section class="sectionEventos" id="eventos">
	<div class="eventos-gradient-overlay">
		<GradientCircles class="eventos-circles" variant="alt2" />
	</div>
	<StyledSectionTitle title="Lo que viene" />
	<SectionTitle>
		Próximos Eventos
	</SectionTitle>
	<div class="eventos-grid">
		{eventos.map((evento) => (
			<article class="evento-card">
				<div class="evento-header">
					<div class="evento-avatar">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"/>
						</svg>
					</div>
					<div class="evento-header-info">
						<h3 class="evento-title">Iglesia Edén Terrassa</h3>
						<p class="evento-date">{evento.date}</p>
					</div>
				</div>
				<div class="evento-content">
					<p class="evento-description">{evento.description}</p>
				</div>
				<img
					src={evento.image}
					alt={evento.imageAlt}
					class="evento-img"
					width="500"
					height="350"
					loading="lazy"
					decoding="async"
				/>
			</article>
		))}
	</div>
</section>

<style>
	.sectionEventos {
		width: 100%;
		min-height: 100vh;
		padding: 100px 25px 60px 25px;
		background-color: #333;
		color: #f7f7f7;
		position: relative;
		overflow: hidden;
	}
	.eventos-gradient-overlay {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
		z-index: 1;
	}
	
	.eventos-grid, .SectionTitle {
		position: relative;
		z-index: 2;
	}

	.eventos-grid {
		width: 100%;
		max-width: 1300px;
		margin: 0 auto;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 2.5rem;
		margin-top: 2.5rem;
	}
	
	/* Facebook-style card */
	.evento-card {
		background: #fff;
		border-radius: 12px;
		box-shadow: 0 2px 8px rgba(85, 96, 61, 0.12), 0 4px 16px rgba(85, 96, 61, 0.08);
		width: 500px;
		
		display: flex;
		flex-direction: column;
		overflow: hidden;
		transition: box-shadow 0.3s ease, transform 0.2s ease;
		border: 1px solid rgba(85, 96, 61, 0.15);
	}
	
	.evento-card:hover {
		box-shadow: 0 4px 16px rgba(85, 96, 61, 0.18), 0 8px 24px rgba(85, 96, 61, 0.12);
		transform: translateY(-2px);
	}
	
	/* Header section (like Facebook post header) */
	.evento-header {
		display: flex;
		align-items: center;
		padding: 1rem 1.2rem;
		gap: 0.75rem;
		background: linear-gradient(135deg, #f9f9f9 0%, #ffffff 100%);
		border-bottom: 1px solid rgba(85, 96, 61, 0.1);
	}
	
	.evento-avatar {
		width: 48px;
		height: 48px;
		border-radius: 50%;
		background: linear-gradient(135deg, #55603d 0%, #6a7a4a 100%);
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		box-shadow: 0 2px 8px rgba(85, 96, 61, 0.25);
	}
	
	.evento-avatar svg {
		width: 28px;
		height: 28px;
		color: #fff;
	}
	
	.evento-header-info {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}
	
	.evento-title {
		font-size: 1rem;
		font-weight: 700;
		color: #55603d;
		margin: 0;
		line-height: 1.3;
	}
	
	.evento-date {
		font-size: 0.85rem;
		color: #6a7a4a;
		margin: 0;
		font-weight: 500;
	}
	
	/* Content section */
	.evento-content {
		padding: 1rem 1.2rem;
		background: #fff;
	}
	
	.evento-description {
		font-size: 0.95rem;
		line-height: 1.5;
		color: #232323;
		margin: 0;
		font-weight: 400;
	}
	
	/* Image */
	.evento-img {
		width: 100%;
		height: 350px;
		object-fit: cover;
		object-position: center;
		display: block;
		border-top: 1px solid rgba(85, 96, 61, 0.1);
		border-bottom: 1px solid rgba(85, 96, 61, 0.1);
		flex-shrink: 0;
	}
	
	/* Actions section (like Facebook reactions) */
	.evento-actions {
		display: flex;
		padding: 0.25rem 0.5rem;
		gap: 0.3rem;
		background: #fff;
		border-top: 1px solid rgba(85, 96, 61, 0.1);
		height: 38px;
		flex-shrink: 0;
	}
	
	.evento-action-btn {
		flex: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		padding: 0.35rem 0.6rem;
		background: transparent;
		border: none;
		border-radius: 4px;
		color: #55603d;
		font-size: 0.8rem;
		font-weight: 600;
		cursor: pointer;
		transition: all 0.2s ease;
		font-family: inherit;
	}
	
	.evento-action-btn:hover {
		background: linear-gradient(135deg, rgba(85, 96, 61, 0.08) 0%, rgba(106, 122, 74, 0.08) 100%);
	}
	
	.evento-action-btn:active {
		transform: scale(0.97);
	}
	
	.evento-action-btn svg {
		width: 16px;
		height: 16px;
		color: #55603d;
	}
	
	.evento-action-btn span {
		color: #55603d;
	}
	
	/* Responsive design */
	@media (max-width: 1100px) {
		.eventos-grid {
			gap: 2rem;
		}
		.evento-card {
			width: 95vw;
			max-width: 500px;
		}
	}
	
	@media (max-width: 900px) {
		.eventos-grid {
			flex-direction: column;
			align-items: center;
			gap: 2rem;
		}
		.evento-card {
			width: 90vw;
			max-width: 500px;
		}
	}
	
	@media (max-width: 600px) {
		.evento-card {
			width: 95vw;
		}
		
		.evento-header {
			padding: 0.9rem 1rem;
		}
		
		.evento-content {
			padding: 0.9rem 1rem;
		}
		
		.evento-actions {
			flex-direction: column;
			gap: 0.4rem;
		}
		
		.evento-action-btn {
			padding: 0.75rem;
			font-size: 0.85rem;
		}
		
		.evento-action-btn span {
			display: none;
		}
		
		.evento-action-btn svg {
			width: 22px;
			height: 22px;
		}
	}
</style>

