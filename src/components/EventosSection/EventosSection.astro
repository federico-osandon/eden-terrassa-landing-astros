---
import SectionTitle from "../Section-Title/Section-Title.astro"
import GradientCircles from '../GradientCircles/GradientCircles.astro';
import StyledSectionTitle from '../StyledSectionTitle/StyledSectionTitle.astro';
---

<section class="sectionEventos">
	<div class="eventos-gradient-overlay">
		<GradientCircles class="eventos-circles" variant="alt2" />
	</div>
	<StyledSectionTitle title="Lo que viene" />
	<SectionTitle>
		Próximos Eventos
	</SectionTitle>
	<div class="eventos-grid">
		<div class="evento-card">
			<img src="/images/hero/hero-image.webp" alt="Evento 1" class="evento-img" />
			<div class="evento-info">
				<h3>Retiro de la Iglesia</h3>
				<p>Noviembre 2025</p>
			</div>
		</div>
		<div class="evento-card">
			<img src="/images/hero/reunion.webp" alt="Evento 2" class="evento-img" />
			<div class="evento-info">
				<h3>Encuentro ministerial</h3>
				<p>Marzo 2026</p>
			</div>
		</div>
		<!-- <div class="evento-card">
			<img src="/images/hero/portada-vivo.webp" alt="Evento 3" class="evento-img" />
			<div class="evento-info">
				<h3>Transmisión Online</h3>
				<p>Sábado 11:00 hs</p>
			</div>
		</div> -->
	</div>
</section>

<style>
	.sectionEventos {
		width: 100%;
		min-height: 100vh;
		padding: 100px 25px 20px 25px;
		background-color: #333;
		color: #f7f7f7;
		position: relative;
		overflow: hidden;
	}
	.eventos-gradient-overlay {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
		z-index: 1;
	}
	
	.eventos-grid, .SectionTitle {
		position: relative;
		z-index: 2;
	}

	.eventos-grid {
		width: 100%;
		max-width: 1300px;
		margin: 0 auto;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 2.5rem;
		margin-top: 2.5rem;
	}
	.evento-card {
		background: #222;
		border-radius: 2rem;
		box-shadow: 0 4px 24px rgba(0,0,0,0.10);
		width: 340px;
		display: flex;
		flex-direction: column;
		align-items: center;
		overflow: hidden;
		border: 3px solid #f7f7f7;
		transition: box-shadow 0.2s, border 0.2s;
	}
	.evento-img {
		width: 100%;
		height: 340px;
		object-fit: cover;
		border-bottom: 2px solid #f7f7f7;
	}
	.evento-info {
		width: 100%;
		padding: 1.2rem 1rem 1rem 1rem;
		background: #fff;
		color: #232323;
		text-align: left;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}
	.evento-info h3 {
		font-size: 1.3rem;
		font-weight: 700;
		color: #B4CD02;
		margin: 0 0 0.3rem 0;
	}
	.evento-info p {
		font-size: 1rem;
		margin: 0;
	}
	@media (max-width: 1100px) {
		.eventos-grid {
			gap: 1.2rem;
		}
		.evento-card {
			width: 95vw;
			max-width: 340px;
		}
	}
	@media (max-width: 900px) {
		.eventos-grid {
			flex-direction: column;
			align-items: center;
			gap: 1.5rem;
		}
		.evento-card {
			width: 90vw;
			max-width: 98vw;
		}
	}
</style>

