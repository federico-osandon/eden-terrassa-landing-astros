---
import SectionTitle from "../Section-Title/Section-Title.astro"
import SpotifyCard from "./SpotifyCard.astro"
import { spotifyTracks } from '../../data/spotify';
---

<section class="spotify-section">
	<SectionTitle>
		Spotify
	</SectionTitle>
	<div class="spotify-content-card">
		{spotifyTracks.map((track) => (
			<a
				href={track.url}
				class="spotify-card"
				target="_blank"
				rel="noreferrer"
				aria-label={`Escuchar ${track.title} en Spotify`}
			>
				<img
					class="spotify-image"
					src={track.image}
					alt={track.title}
					width="352"
					height="352"
					loading="lazy"
					decoding="async"
				/>
			</a>
		))}
	</div>
</section>

<style>
	.spotify-section {
		width: 100%;
		min-height: 100vh;

		padding: 100px 25px 20px 25px;

		background-color: #333;
		color: #f7f7f7f7;

		position: relative;
		display: flex;
		flex-wrap: wrap;
	

		
	}

	

	.spotify-content-card {
		width: 100%;
		height: 90%;

		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
	}


	.spotify-card{
        /* background-image: url('/spotify/arbol-vida.png');
		background-size: contain;
		background-repeat: no-repeat;
		background-position: center; */
		display: flex;
		justify-content: center;
		align-items: center;
		
		margin: 15px auto;
		width: 30%;
		height: 352px;
       

    }
	.spotify-card{
        
        margin: 15px auto;

        width: 30%;
        /* height: 352px; */
        /* max-width: 600px; */

    }

	.spotify-image {
		width: 352px;
		height: 352px;
		object-fit: cover;
		border-radius: 12px;

		cursor: pointer;
	}

	/* el media entre 600 y 768 */

	@media screen and (min-width: 813px) and (max-width: 1219px){
		/* .spotify-content1 {
			background-image: url('/spotify/arbol-vida-gr.png');
            width: 100%;
        } */
        .spotify-card{
			width: 50%;
        }
    }
	@media (max-width: 812px) {
		/* .spotify-content1 {
			background-image: url('/spotify/arbol-vida.png');
			width: 100%;
			margin: 15px auto;
		} */
		.spotify-card{
			width: 100%;
			/* margin: 15px auto; */
		}
	}
</style>
